{
    "name": "uuf6429/phpstan-phpdoc-type-resolver",
    "description": "Resolve (fully qualify) types from PHPStan's PHPDoc parser",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "phpstan",
        "phpdoc",
        "phpdoc-parser",
        "types",
        "type resolver",
        "classname"
    ],
    "authors": [
        {
            "name": "Christian Sciberras",
            "homepage": "https://christian.sciberras.me"
        }
    ],
    "homepage": "https://github.com/uuf6429/phpstan-phpdoc-type-resolver",
    "require": {
        "php": "^8",
        "phpstan/phpdoc-parser": "^2"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.7",
        "friendsofphp/php-cs-fixer": "^3.53",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "uuf6429\\PHPStanPHPDocTypeResolver\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "uuf6429\\PHPStanPHPDocTypeResolverTests\\": "tests/"
        },
        "files": [
            "tests/Fixtures/functions.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true
        },
        "process-timeout": 0
    },
    "scripts": {
        "lint": [
            "composer normalize --dry-run",
            "composer exec phpstan -- analyse --no-progress",
            "composer exec php-cs-fixer -- fix --dry-run --show-progress=none --diff"
        ],
        "lint:fix": [
            "composer normalize",
            "composer exec php-cs-fixer -- fix --show-progress=dots --diff"
        ],
        "test": "phpunit -dzend_extension=php_xdebug -dxdebug.mode=coverage --colors=always ./tests/"
    }
}
